DATABASE_PATH=data/bugfix.sqlite
LOG_LEVEL=info
DATA_ROOT=data
MAX_ATTACHMENT_BYTES=52428800
PORT=8033
BUGFIX_LISTEN_HOST=127.0.0.1
# Safe offline defaults. Set DRY_RUN=false only when a local, allow-listed remote is intended.
DRY_RUN=true
FIXER_TIMEOUT_MS=2700000
REVIEWER_TIMEOUT_MS=900000
PI_FIXER_MAX_TURNS=80
PI_REVIEWER_MAX_TURNS=80
PI_FIXER_MAX_TOOL_CALLS=240
PI_REVIEWER_MAX_TOOL_CALLS=240
PI_FIXER_MAX_REPEATED_TOOL_CALLS=4
PI_REVIEWER_MAX_REPEATED_TOOL_CALLS=4
PI_FIXER_CLOSEOUT_GRACE_MS=15000
PI_REVIEWER_CLOSEOUT_GRACE_MS=15000
ENVIRONMENT_TIMEOUT_MS=600000

# Queue lease and dispatcher concurrency. The default keeps the historical
# single-worker behavior; increase only after validating host capacity.
DISPATCHER_MAX_CONCURRENT_JOBS=1
JOB_LEASE_TIMEOUT_MS=3600000
JOB_HEARTBEAT_INTERVAL_MS=15000

# Optional YAML registry for heterogeneous Intake/Fixer/Reviewer backends.
# Each backend references a secret by environment-variable name (apiKeyEnv);
# the key itself is never put in this file, the database, or artifacts.
LLM_BACKENDS_CONFIG_PATH=

# Legacy fallback when LLM_BACKENDS_CONFIG_PATH is empty. These two values
# must be set together; the resulting `legacy` backend has capacity one.
LLM_ENDPOINT_URL=
LLM_MODEL=
LLM_API_KEY=
INTAKE_LLM_TIMEOUT_MS=60000
INTAKE_CONFIG_PATH=config/bug-intake.md
# Development request/response logging may contain reporter-provided data.
INTAKE_LLM_LOG=1

# A non-empty profile is a deployment declaration that enables the Pi repair
# worker; it does not create a sandbox. PI_BASH_SHELL must point to an actual
# externally managed sandbox wrapper when bash isolation is required.
PI_SANDBOX_PROFILE=
# PI_BASH_SHELL=/path/to/sandbox-wrapper
# This confines Pi edit/write tools to the worktree, but does not confine bash.
PI_CONFINE_WORKSPACE=1

# Optional static profile catalog. Leave unset to let Intake create profiles
# from a confirmed HTTPS/SSH remote under DATA_ROOT/generated-environments.yaml.
# ENVIRONMENT_CONFIG_PATH=config/environments.yaml
GIT_ALLOWED_HOSTS=localhost

# GitLab credentials stay in process memory and are passed to Git through an
# in-memory credential helper; ~/.git-credentials is not read or written.
GITLAB_URL=http://172.29.100.126
GITLAB_ACCOUNT=codigger-llm
GITLAB_TOKEN=
# Optional fallback: bootstrap a PAT once per process when GITLAB_TOKEN is empty.
# GITLAB_PASSWORD=

# Weekly email is disabled while all three lines below remain commented out.
# The SMTPS URL is optional and has this one permitted/default value only.
# WEEKLY_EMAIL_SMTP_URL=smtps://mail.onecloud.cn:465
# WEEKLY_EMAIL_USERNAME=sender@example.com
# WEEKLY_EMAIL_PASSWORD=replace-with-smtp-password
# WEEKLY_EMAIL_RECIPIENTS=owner@example.com,team@example.com
# Internal test only: disables SMTP certificate and hostname verification.
# WEEKLY_EMAIL_ALLOW_INSECURE_TLS=false
