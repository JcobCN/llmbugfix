DATABASE_PATH=data/bugfix.sqlite
LOG_LEVEL=info
DATA_ROOT=data
MAX_ATTACHMENT_BYTES=52428800
# Safe offline defaults. Set DRY_RUN=false only when a local, allow-listed remote is intended.
DRY_RUN=true
FIXER_TIMEOUT_MS=2700000
REVIEWER_TIMEOUT_MS=900000
ENVIRONMENT_TIMEOUT_MS=600000
PIPELINE_TIMEOUT_MS=5400000
LLM_ENDPOINT_URL=
LLM_MODEL=
LLM_API_KEY=
INTAKE_CONFIG_PATH=config/bug-intake.md
# Optional static profile catalog. Leave unset to let Intake create profiles
# from a confirmed HTTPS/SSH remote under DATA_ROOT/generated-environments.yaml.
# ENVIRONMENT_CONFIG_PATH=config/environments.yaml
LLM_HOST=disabled://local
VISION_HOST=disabled://local
GIT_HOST=localhost
GIT_ALLOWED_HOSTS=localhost
