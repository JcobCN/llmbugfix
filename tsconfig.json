{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@llmbugfix/shared": ["packages/shared/src/index.ts"],
      "@llmbugfix/bug-domain": ["packages/bug-domain/src/index.ts"],
      "@llmbugfix/bug-repository": ["packages/bug-repository/src/index.ts"],
      "@llmbugfix/intake-agent": ["packages/intake-agent/src/index.ts"],
      "@llmbugfix/intake-policy": ["packages/intake-policy/src/index.ts"],
      "@llmbugfix/attachment-service": ["packages/attachment-service/src/index.ts"],
      "@llmbugfix/vision-provider": ["packages/vision-provider/src/index.ts"],
      "@llmbugfix/environment-resolver": ["packages/environment-resolver/src/index.ts"],
      "@llmbugfix/job-queue": ["packages/job-queue/src/index.ts"],
      "@llmbugfix/repo-manager": ["packages/repo-manager/src/index.ts"],
      "@llmbugfix/environment-runner": ["packages/environment-runner/src/index.ts"],
      "@llmbugfix/pi-runner": ["packages/pi-runner/src/index.ts"],
      "@llmbugfix/validator": ["packages/validator/src/index.ts"],
      "@bug-agent/shared": ["packages/shared/src/index.ts"],
      "@bug-agent/bug-domain": ["packages/bug-domain/src/index.ts"],
      "@bug-agent/bug-repository": ["packages/bug-repository/src/index.ts"],
      "@bug-agent/intake-agent": ["packages/intake-agent/src/index.ts"],
      "@bug-agent/intake-policy": ["packages/intake-policy/src/index.ts"],
      "@bug-agent/attachment-service": ["packages/attachment-service/src/index.ts"],
      "@bug-agent/vision-provider": ["packages/vision-provider/src/index.ts"],
      "@bug-agent/environment-resolver": ["packages/environment-resolver/src/index.ts"],
      "@bug-agent/job-queue": ["packages/job-queue/src/index.ts"],
      "@bug-agent/repo-manager": ["packages/repo-manager/src/index.ts"],
      "@bug-agent/environment-runner": ["packages/environment-runner/src/index.ts"],
      "@bug-agent/pi-runner": ["packages/pi-runner/src/index.ts"],
      "@bug-agent/validator": ["packages/validator/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "apps/*/src/**/*",
    "tests/**/*",
    "vitest.config.ts"
  ]
}
